# voicehack の設定ひな形. `cp .env.example .env` でコピーし, .env の方に値を書く.
# .env は git 管理外. このファイル (.env.example) には実際のキーや ID を書かないこと.
# 使う機能の項目だけ埋めればよい.

# ===== 1. リアルタイム文字起こしアプリ (Node.js) =====
# Google Cloud credentials
# サービスアカウントキー(JSON)のパス。gcloud auth application-default login を使う場合は空でもよい
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# GCPプロジェクトID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Speech-to-Text の実行リージョン。Chirp 3 のストリーミングは "us" / "eu" マルチリージョンのみ GA
# (us-central1 のような単一リージョンでは chirp_3 は使えない)
GOOGLE_CLOUD_LOCATION=us

# 使用する認識モデル。Chirp 3 系: chirp_3 (低レイテンシ・多言語対応)
# 使えない場合は chirp_2 / chirp / latest_long にフォールバックしてください
SPEECH_MODEL=chirp_3

# 認識する言語 (BCP-47)
SPEECH_LANGUAGE=ja-JP

# サーバーのポート
PORT=3000

# 録音終了後の音声解析 (2. の Python ツールを呼ぶ)。false で無効化
ANALYSIS_ENABLED=true
# 解析コマンドと追加オプション (例: ANALYSIS_ARGS=--sr 16000 --asr groq)
ANALYSIS_CMD=uv run voicehack
ANALYSIS_ARGS=--sr 16000

# ===== 2. 音声解析ツール (Python) =====
# キーを探す順番: 環境変数 GROQ_API_KEY → リポジトリ直下の .env → macOS キーチェーン (サービス名 GROQ_API_KEY)
# ファイルに平文で置きたくない場合は .env を作らず, キーチェーンに保存する (README 参照).

# Groq Cloud の API キー (`--asr groq` を使うときだけ必要). https://console.groq.com/keys
GROQ_API_KEY=

# ===== 3. レシピ化 (OpenAI API) =====
# 文字起こしから LLM でレシピを組み立て、足りない情報を質問する。システムプロンプトは prompts/recipe_system.md
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
